# ============================================
# 文档转换器 (pdf_word_to_markdown) 配置文件
# 复制此文件为 .env 并填入你的 API key
# ============================================

# --- Kimi 视觉 API (Moonshot) ---
# 获取 key: https://platform.kimi.com
# 模型: moonshot-v1-8k-vision-preview (推荐/省token)
#       kimi-k2.6 (最强)
MOONSHOT_API_KEY=

# --- OpenAI 视觉 API ---
# 获取 key: https://platform.openai.com/api-keys
# 模型: gpt-4o-mini (推荐/省token)
OPENAI_API_KEY=

# --- DeepSeek 视觉 API ---
# 获取 key: https://platform.deepseek.com/api_keys
# 注意: 需开通视觉权限
# 模型: deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=

# --- Anthropic Claude 视觉 API ---
# 获取 key: https://console.anthropic.com
# 模型: claude-haiku-4-5 (推荐/省token)
ANTHROPIC_API_KEY=

# --- 自定义 OpenAI 兼容 API ---
# 适用: SiliconFlow, DeepInfra, Fireworks 等
CUSTOM_VISION_API_KEY=
CUSTOM_VISION_BASE_URL=
CUSTOM_VISION_MODEL=
